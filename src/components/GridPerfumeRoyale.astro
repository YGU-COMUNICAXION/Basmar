];
---

<section id="for-her" class="py-16 md:py-12">
  <div class="container mx-auto px-4">
    <div class="mb-10 text-center">
      <a
        href="/zahreen-original"
        class="inline-flex items-center gap-3 font-desert text-xl tracking-wide text-dark-purple md:text-3xl"
      >
        GO TO ZAHREEN
        <span class="text-2xl leading-none md:text-4xl">&gt;</span>
      </a>
    </div>

    <h2 class="mb-2 text-center font-desert text-3xl tracking-wide text-dark-purple md:text-4xl">
      FOR HER
    </h2>

    <p class="mb-8 text-center text-dark-purple md:mb-12 md:text-xl font-light italic lg:text-2xl">
      Fragrances that capture the poetry of Arabian femininity.
    </p>

    <div class="mb-16 md:mb-12 lg:mb-20 grid grid-cols-1 gap-6 lg:gap-12 xl:gap-16 sm:grid-cols-2">
      {perfumes.slice(0, 2).map((p) => <CardPerfume p={p} />)}
    </div>

    <h2 class="mb-2 text-center font-desert text-3xl tracking-wide text-dark-purple md:text-4xl">
      FOR HIM
    </h2>

    <p class="mb-8 text-center text-dark-purple md:mb-12 md:text-xl font-light italic lg:text-2xl">
      Fragrances that embody the Arabian depth, warmth, and character.
    </p>

    <div class="grid grid-cols-1 gap-6 lg:gap-12 xl:gap-16 sm:grid-cols-2">
      {perfumes.slice(2, 4).map((p) => <CardPerfume p={p} />)}
    </div>
  </div>

  <div id="modal-royale" class="fixed inset-0 z-[100] hidden bg-black/60 backdrop-blur-sm" data-open="">
    <ModalProduct containerId="modal-royale" items={perfumes} client:load />
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const modal = document.getElementById("modal-royale");
    if (!modal) return;

    document.querySelectorAll(".product-card").forEach((card) => {
      card.addEventListener("click", () => {
        const productId = card.getAttribute("data-product");
        if (!productId) return;
        modal.classList.remove("hidden");
        modal.setAttribute("data-open", productId);
        document.body.classList.add("no-scroll");
      });
    });

    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        modal.classList.add("hidden");
        modal.setAttribute("data-open", "");
        document.body.classList.remove("no-scroll");
      }
    });
  });
</script>
