---
import ModalProduct from "@components/ModalProduct";
import CardPerfume from "./CardPerfume.astro";

import cardLayla from "@assets/imgs/her/laylaCard.png";
import mediaLayla from "@assets/imgs/her/layla2.png";

import cardNoora from "@assets/imgs/her/nooraCard.png";
import mediaNoora from "@assets/imgs/her/noora2.png";

import cardAtheer from "@assets/imgs/him/atheerCard.png";
import mediaAtheer from "@assets/imgs/him/atheer2.png";

import cardYazan from "@assets/imgs/him/yazanCard.png";
import mediaYazan from "@assets/imgs/him/yazan2.png";

interface Perfume {
  id: string;
  slug: string;
  card: {
    title: string;
    thumb: ImageMetadata;
    alt: string;
  };
  modal: {
    title: string;
    retailers: string;
    categories: string;
    size: string;
    notesTop: string;
    notesHeart: string;
    notesBase: string;
    description: string;
    video?: string;
    poster: ImageMetadata;
    img1: ImageMetadata;
    img2: ImageMetadata;
    bgImage: string;
    theme: string;
  };
}

const perfumes: Perfume[] = [
  {
    id: "noora-vanille",
    slug: "noora-vanille",
    card: {
      title: "Noora Vanille",
      thumb: cardNoora,
      alt: "Noora Vanille perfume",
    },
    modal: {
      title: "NOORA VANILLE",
      retailers: "Available at Marshalls, TJ Maxx, TK Maxx and Winners stores.",
      categories: "ROYAL EDITION",
      size: "3.4 OZ./100 ML",
      notesTop: "PENDING",
      notesHeart: "PENDING",
      notesBase: "PENDING",
      description: "Fragrance details will be updated with the final Royale information.",
      poster: cardNoora,
      img1: cardNoora,
      img2: mediaNoora,
      bgImage: "#3E0E3D",
      theme: "#E7B8DD",
    },
  },
  {
    id: "layla-jasmine",
    slug: "layla-jasmine",
    card: {
      title: "Layla Jasmine",
      thumb: cardLayla,
      alt: "Layla Jasmine perfume",
    },
    modal: {
      title: "LAYLA JASMINE",
      retailers: "Available at Marshalls, TJ Maxx, TK Maxx and Winners stores.",
      categories: "ROYAL EDITION",
      size: "3.4 OZ./100 ML",
      notesTop: "PENDING",
      notesHeart: "PENDING",
      notesBase: "PENDING",
      description: "Fragrance details will be updated with the final Royale information.",
      poster: cardLayla,
      img1: cardLayla,
      img2: mediaLayla,
      bgImage: "#2E0D2D",
      theme: "#D9A7D4",
    },
  },
  {
    id: "yazan-spice",
    slug: "yazan-spice",
    card: {
      title: "Yazan Spice",
      thumb: cardYazan,
      alt: "Yazan Spice perfume",
    },
    modal: {
      title: "YAZAN SPICE",
      retailers: "Available at Marshalls, TJ Maxx, TK Maxx and Winners stores.",
      categories: "ROYAL EDITION",
      size: "3.4 OZ./100 ML",
      notesTop: "PENDING",
      notesHeart: "PENDING",
      notesBase: "PENDING",
      description: "Fragrance details will be updated with the final Royale information.",
      poster: cardYazan,
      img1: cardYazan,
      img2: mediaYazan,
      bgImage: "#2D1A10",
      theme: "#E9C6A0",
    },
  },
  {
    id: "atheer-fireside",
    slug: "atheer-fireside",
    card: {
      title: "Atheer Fireside",
      thumb: cardAtheer,
      alt: "Atheer Fireside perfume",
    },
    modal: {
      title: "ATHEER FIRESIDE",
      retailers: "Available at Marshalls, TJ Maxx, TK Maxx and Winners stores.",
      categories: "ROYAL EDITION",
      size: "3.4 OZ./100 ML",
      notesTop: "PENDING",
      notesHeart: "PENDING",
      notesBase: "PENDING",
      description: "Fragrance details will be updated with the final Royale information.",
      poster: cardAtheer,
      img1: cardAtheer,
      img2: mediaAtheer,
      bgImage: "#231A12",
      theme: "#E7C9A5",
    },
