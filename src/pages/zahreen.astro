---
import Layout from "@layouts/Layout.astro";
import logo from "@assets/logo.svg";
import bannerVideoMp4 from "@assets/videos/Banner.mp4";
import bannerVideoWebm from "@assets/videos/Banner.webm";
import wahajCard from "@assets/imgs/him/wahajCard.jpg";
import rawnaqCard from "@assets/imgs/him/rawnaqCard.jpg";
---

<Layout title="Choose your collection">
  <main class="collection-selector">
    <video class="selector-bg-video" autoplay muted loop playsinline preload="auto" aria-hidden="true">
      <source src={bannerVideoWebm} type="video/webm" />
      <source src={bannerVideoMp4} type="video/mp4" />
    </video>

    <div class="selector-overlay"></div>

    <img src={logo.src} alt="Basmar Beauty" class="brand-logo" loading="eager" />

    <section class="selector-content">
      <h1>Choose your collection</h1>

      <div class="cards-grid">
        <a class="collection-card" href="/zahreen-royale">
          <img src={rawnaqCard.src} alt="Zahreen Royale collection" loading="lazy" />
          <span>
            Zahreen Royale
            <b aria-hidden="true">&gt;</b>
          </span>
        </a>

        <a class="collection-card" href="/zahreen-original">
          <img src={wahajCard.src} alt="Zahreen collection" loading="lazy" />
          <span>
            Zahreen
            <b aria-hidden="true">&gt;</b>
          </span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .collection-selector {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    padding: 2rem 1.25rem;
    color: #d6aa63;
    overflow: hidden;
  }

  .selector-bg-video,
  .selector-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .selector-bg-video {
    object-fit: cover;
    z-index: -2;
  }

  .selector-overlay {
    background:
      radial-gradient(circle at top center, rgba(126, 15, 15, 0.4), rgba(8, 0, 0, 0.8) 58%),
      linear-gradient(to bottom, rgba(43, 2, 2, 0.6), rgba(12, 1, 1, 0.9));
    z-index: -1;
  }

  .brand-logo {
    width: clamp(100px, 12vw, 140px);
  }

  .selector-content {
    max-width: 920px;
    margin: 2.5rem auto 0;
    text-align: center;
  }

  h1 {
    margin-bottom: 2rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: #d6aa63;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .collection-card {
    position: relative;
    display: block;
    border: 1px solid rgba(214, 170, 99, 0.85);
    background: rgba(16, 1, 1, 0.65);
    text-decoration: none;
    overflow: hidden;
    min-height: 520px;
  }

  .collection-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .collection-card span {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    width: min(260px, calc(100% - 2rem));
    border: 1px solid rgba(214, 170, 99, 0.85);
    color: #e4bb77;
    background: rgba(17, 5, 5, 0.5);
    padding: 0.5rem 0.75rem;
    font-size: 1.4rem;
    line-height: 1.2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .collection-card span b {
    font-weight: 400;
    font-size: 1.9rem;
    line-height: 1;
  }

  .collection-card:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 768px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }

    .collection-card {
      min-height: 440px;
    }

    .selector-content {
      margin-top: 1.5rem;
    }
  }
</style>
