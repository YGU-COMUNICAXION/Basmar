---
import Layout from "@layouts/Layout.astro";
import FormRegister from "@components/FormRegister.astro";
import HeroBanner from "@components/HeroBanner.astro";
import InfoSectionRoyale from "@components/InfoSectionRoyale.astro";
import Footer from "@components/Footer.astro";
import GridPerfumeRoyale from "@components/GridPerfumeRoyale.astro";
---

<Layout title="Zahreen Royale">
  <HeroBanner
    title="DISCOVER ZAHREEN ROYALE"
    subtitle="The alchemy of Arabian past and present."
    description="Zahreen is a collection that reimagines the most exclusive Arabian fragrances into essential everyday indulgences."
  />
  <GridPerfumeRoyale />
  <InfoSectionRoyale />
  <FormRegister />
  <Footer />
</Layout>
